generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Matches Supabase Auth UUID
  email     String   @unique
  name      String?
  avatarUrl String?
  role         String         @default("USER") // USER, OPERATOR, ADMIN
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  loginHistory LoginHistory[]
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  loginAt   DateTime @default(now())
}

model Trip {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  tagline       String
  description   String
  category      String      // Coastal, Mountain, Urban, Valley
  price         Int         // in whole dollars (max $650)
  duration      String      // "3 Days", "7 Days", etc.
  maxSeats      Int
  filledSeats   Int         @default(0)
  departureDate DateTime
  imageUrl      String
  badge         String?     // "Bestseller", "Premium", "New"
  status        String      @default("Published") // Published, Draft, Archived
  rating        Float       @default(4.5)
  highlights    String      // JSON array stored as string
  itinerary     String      // JSON array stored as string
  included      String      // JSON array stored as string
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  enquiries     Enquiry[]
  departures    Departure[]
}

model Departure {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date      DateTime
  time      String
  seatsLeft Int
  status    String   @default("Open") // Open, Filling Fast, Almost Full
}

model Enquiry {
  id          String   @id @default(cuid())
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  packageId   String?
  package     Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userName    String
  userEmail   String
  status      String   @default("Pending") // Pending, Confirmed, Waitlisted
  requestedOn DateTime @default(now())
  message     String?
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // SEAT_ALERT, PRICE_DROP, NEW_TRIP, SYSTEM_UPDATE
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Package {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  tagline         String
  description     String
  tierBadge       String      // e.g., "HIGH-ALTITUDE JOURNEYS"
  bundlePrice     Int
  duration        String
  maxSeats        Int
  filledSeats     Int         @default(0)
  imageUrl        String
  videoUrl        String?
  status          String      @default("Published")
  itinerary       String      // JSON array: [{ day, title, description, location }]
  inclusions      String      // JSON array: ["Premium Stay", "All Transport", "Local Guide"]
  includedTripIds String      // JSON array of Trip IDs this package bundles
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  enquiries       Enquiry[]
}

model TravelDNA {
  id        String   @id @default(cuid())
  userId    String?
  scores    String   // JSON string of TravelDnaScores
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TravelState {
  id            String   @id @default(cuid())
  userId        String?
  currentState  String   @default("Escape")
  startLocation String?
  maxBudgetInr  Int?
  updatedAt     DateTime @updatedAt
}

model LocalInsight {
  id              String   @id @default(cuid())
  tripId          String?
  locationName    String
  type            String   // SECRET, MISTAKE, CULTURAL, BEST_TIME
  title           String
  content         String
  confidenceScore Int      @default(90)
  source          String
  createdAt       DateTime @default(now())
}

model RecommendationFeedback {
  id        String   @id @default(cuid())
  userId    String?
  tripId    String?
  reason    String
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// WORD-OF-MOUTH INTELLIGENCE ENGINE MODELS
// ═══════════════════════════════════════════════════════════

model TravelerExperience {
  id                String   @id @default(cuid())
  userId            String?
  destinationName   String
  tripId            String?
  contributorType   String   @default("COMMUNITY") // LOCAL, EXPERIENCED_TRAVELER, VERIFIED_GUIDE, TOUR_OPERATOR, COMMUNITY
  contributorName   String   @default("Anonymous Traveler")
  isVerified        Boolean  @default(false)
  worthIt           Boolean?
  bestTime          String?
  crowdLevel        String?  // LOW, MEDIUM, HIGH, EXTREME
  costReality       String?
  walkingIntensity  String?  // LOW, MEDIUM, HIGH
  unexpectedProblem String?
  bestPart          String?
  whatToAvoid        String?
  localTip          String?
  recommendation    String?
  createdAt         DateTime @default(now())
}

model LocalContributor {
  id               String   @id @default(cuid())
  userId           String?
  name             String
  type             String   // LOCAL, EXPERIENCED_TRAVELER, VERIFIED_GUIDE, TOUR_OPERATOR
  isVerified       Boolean  @default(false)
  accuracyScore    Int      @default(80) // 0-100
  helpfulReports   Int      @default(0)
  totalReports     Int      @default(0)
  joinedAt         DateTime @default(now())
}

model DestinationPulse {
  id              String   @id @default(cuid())
  destinationName String
  weather         String?
  crowdLevel      String?
  alerts          String?  // JSON array
  localActivity   String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model InsightConfirmation {
  id        String   @id @default(cuid())
  insightId String
  userId    String?
  confirmed Boolean  // true = confirms, false = contradicts
  comment   String?
  createdAt DateTime @default(now())
}

model TravelAlert {
  id              String   @id @default(cuid())
  destinationName String
  alertType       String   // ROAD_BLOCKED, CLOSURE, CROWD, PRICE, WEATHER, SAFETY
  title           String
  content         String
  severity        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  reportCount     Int      @default(1)
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
